# macOS
.DS_Store

# ── HTML build outputs ───────────────────────────────────────
# Generated HTML files (built from JSON via scripts/build.mjs)
resumes/*.html
!resumes/sample-resume.html

# ── Personal resume data & photos ───────────────────────────
# Keep only the committed sample files; ignore everything else in resumes/
resumes/*
!resumes/sample-resume.json
!resumes/sample-photo.jpg
!resumes/sample-resume.html

# ── Node ────────────────────────────────────────────────────
node_modules/

# ── Legacy / LaTeX auxiliary files ──────────────────────────
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.lof
*.log
*.lot
*.out
*.run.xml
*.toc
*.xdv
*.synctex.gz
*.pdf

# ── Temporary files ──────────────────────────────────────────
*.tmp
*.bak
*~
